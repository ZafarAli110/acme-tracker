{
  "name": "acme-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "reset": "bun scripts/reset.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "oxlint src web scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "gate": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  }
}
